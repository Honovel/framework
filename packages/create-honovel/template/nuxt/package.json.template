{
  "scripts": {
    "typecheck:frontend": "nuxt prepare frontend && nuxt typecheck frontend",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "build:frontend": "honovel frontend:build",
    "build": "npm run cf-typegen && npm run typecheck:frontend && npm run build:frontend && honovel cloudflare:deploy --dry-run --outdir dist/worker",
    "dev:frontend": "nuxt dev frontend --port 5173 --host localhost --strictPort",
    "dev": "honovel cloudflare:dev",
    "dev:debug": "honovel cloudflare:dev --debug",
    "deploy": "npm run cf-typegen && npm run build:frontend && honovel cloudflare:deploy --minify"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "nuxt": "^4.6.4",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.3.7",
    "vue-tsc": "^3.1.1"
  },
  "overrides": {
    "@vercel/nft": {
      "glob": "^14.0.2"
    },
    "readdir-glob": {
      "minimatch": "^11.0.1"
    }
  }
}
