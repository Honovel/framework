        <div class="flex items-center gap-3">
          <span class="size-2 rounded-full" :class="state === 'online' ? 'bg-emerald-700' : state === 'offline' ? 'bg-accent' : 'bg-muted'" aria-hidden="true"></span>
          <span role="status" aria-live="polite" class="text-sm font-semibold">{{ status }}</span>
          <code class="hidden text-xs text-muted sm:inline">GET /api/health</code>
        </div>
        <button type="button" class="text-link -my-2" :disabled="state === 'checking'" @click="checkHealth">{{ state === 'checking' ? 'Checking…' : 'Check again' }} <span aria-hidden="true">↻</span></button>
      </div>
