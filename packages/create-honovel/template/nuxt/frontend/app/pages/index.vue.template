<script setup lang="ts">
import { computed, onMounted, ref } from 'vue'

useSeoMeta({
  title: '__PROJECT_NAME__ · Honovel',
  description: 'A Honovel application powered by Nuxt.',
})

const state = ref<'checking' | 'online' | 'offline'>('checking')
const status = computed(() => ({ checking: 'Checking connection', online: 'API connected', offline: 'API unavailable' })[state.value])

async function checkHealth() {
  state.value = 'checking'
  try {
    const response = await fetch('/api/health', { signal: AbortSignal.timeout(5000) })
    if (!response.ok) throw new Error('Health request failed')
    const body = await response.json() as { status?: string }
    state.value = body.status === 'ok' ? 'online' : 'offline'
  } catch {
    state.value = 'offline'
  }
}

onMounted(checkHealth)
</script>

