import {
  Cache,
  createDecorator,
  TooManyRequestsException,
} from '@honovel/core'

/**
 * Default API rate limit: 200 requests per minute per client IP.
 *
 * This can be adapted to user-, account-, token-, or route-based limits if needed.
 */
export const IpRateLimit = createDecorator(
  [Cache],
  async (context, cache, attempts: number) => {
    const forwardedFor = context.req.header('X-Forwarded-For')
    const ip = context.req.header('CF-Connecting-IP')
      ?? forwardedFor?.split(',')[0]?.trim()
      ?? 'unknown'

    const currentAttempts = await cache.increment(
      'rate-limit',
      `api:${ip}`,
      1,
      60_000,
    )

    if (currentAttempts > attempts) {
      throw new TooManyRequestsException()
    }
  },
  { cache: false },
)

