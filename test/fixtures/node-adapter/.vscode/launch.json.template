{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Honovel Node (dev)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/.honovel/index.js",
      "runtimeArgs": [
        "--enable-source-maps",
        "--inspect=127.0.0.1:9229"
      ],
      "preLaunchTask": "honovel:dev-build",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal"
    }
  ]
}
