import { serve } from '@hono/node-server'
import { serveStatic } from '@hono/node-server/serve-static'
import { createHonoApp } from '@honovel/core'
import { startCronJobs } from '@honovel/node'
import type { AppEnv } from './src/env'

declare const process: {
  argv: string[]
  env: {
    PORT?: string
    APP_DEBUG?: string
    HONOVEL_FRONTEND_DEV_URL?: string
  }
}

const app = createHonoApp<AppEnv>()

type HonovelRuntimeApp = typeof app & {
  honovelDocumentation?: {
    enabled: boolean
    swaggerPath: string
    openApiPath: string
  }
}

function registerSpaAssets(application: typeof app): void {
  application.use('*', serveStatic({ root: './dist/frontend' }))
  application.get('*', serveStatic({ path: './dist/frontend/index.html' }))
}

function debugEnabled(value: string | undefined): boolean {
  return typeof value === 'string' && ['1', 'true', 'yes', 'on'].includes(value.trim().toLowerCase())
}

const isMainModule = process.argv[1]
  ? import.meta.url === new URL(process.argv[1], 'file:').href
  : false

if (isMainModule) {
  const frontendDevUrl = process.env.HONOVEL_FRONTEND_DEV_URL
  if (!frontendDevUrl) registerSpaAssets(app)

  const bindings: AppEnv['Bindings'] = {
    APP_DEBUG: process.env.APP_DEBUG,
  }

  startCronJobs(app, { bindings })

  serve({
    fetch: (request) => app.fetch(request, bindings),
    port: Number(process.env.PORT ?? 3000),
  }, ({ port }) => {
    const backendUrl = `http://localhost:${port}`
    const baseUrl = frontendDevUrl ?? backendUrl
    const documentation = (app as HonovelRuntimeApp).honovelDocumentation

    if (documentation?.enabled) {
      console.log(`Swagger at: ${baseUrl}${documentation.swaggerPath}`)
      console.log(`OpenApi at: ${baseUrl}${documentation.openApiPath}`)
    }

    console.log(frontendDevUrl ? `Honovel app at: ${baseUrl}` : `Honovel listening on ${baseUrl}`)
    console.log(`Debug-Mode: ${debugEnabled(process.env.APP_DEBUG) ? 'On' : 'Off'}`)
  })
}

export default app
